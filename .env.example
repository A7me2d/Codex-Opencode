# Relay Room — every knob this app reads, in one place.
#
# Copy this file to `.env` and edit there; `.env` is git-ignored and `.env.example`
# is the documentation. Nothing here is secret: the `VITE_` values are compiled
# into the browser bundle and are public by definition. Never put a token here.
#
# Values are read once at startup. A typo degrades to the documented default
# instead of breaking the app, so a bad number will not stop polling.

# ---------------------------------------------------------------------------
# Server (server.mjs) — read from the real environment, not from this file
# ---------------------------------------------------------------------------
# Port the Relay Room API listens on. Also the port Vite proxies /api to in dev.
OPENCODE_OBSERVER_PORT=4280

# The project folder Relay Room watches and scopes OpenCode sessions to.
# Defaults to the repository's parent folder.
# WATCH_ROOT=D:\opencode-observer

# The OpenCode model new conversations start on, as providerID/modelID.
# Change it per conversation from the model picker in the handoff rail; this is
# only the starting point. Run `opencode api GET /api/model` for the full list.
OPENCODE_MODEL=opencode/big-pickle

# Absolute paths to the two CLIs, when they are not on PATH.
# Relay Room searches the usual install locations first and only needs these if
# it reports that it could not find an executable.
# OPENCODE_EXE=D:\tools\opencode.exe
# CODEX_EXE=D:\tools\codex.exe

# ---------------------------------------------------------------------------
# Browser (Vite) — only VITE_-prefixed values reach the UI
# ---------------------------------------------------------------------------
# Shown in the header and in the tab title.
VITE_APP_TITLE=Coding Room

# Prefix for every API call. Empty means "same origin", which is what the Vite
# dev proxy provides. Set it only when the API is served from somewhere else.
VITE_API_BASE=

# Polling intervals in milliseconds. Turn state is the fastest signal (the
# composer and the alerts depend on it); agent health changes slowly and can
# stay cheap. Each value is clamped to a sane range, so extremes are ignored.
VITE_POLL_TURN_MS=800
VITE_POLL_HANDOFF_MS=1200
VITE_POLL_MESSAGES_MS=1400
VITE_POLL_EVENTS_MS=3000
VITE_POLL_THREADS_MS=5000
VITE_POLL_CODEX_STATUS_MS=10000
VITE_POLL_OPENCODE_STATUS_MS=10000
VITE_POLL_MODELS_MS=60000
VITE_POLL_PROJECT_MS=60000

# How close to the bottom still counts as "following the newest message".
VITE_STICKY_SCROLL_PX=72

# A Codex turn shorter than this is a blip, not news worth an alert.
VITE_MIN_TURN_MS=4000

# How long a non-blocking alert stays on screen, and how many stack up at once.
VITE_ALERT_TIMEOUT_MS=9000
VITE_MAX_ALERTS=3
