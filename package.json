{
  "name": "openzero",
  "version": "1.0.0",
  "main": "electron/main.mjs",
  "private": true,
  "type": "module",
  "description": "OpenZero - local desktop app for Codex and OpenCode.",
  "author": "OpenZero",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "npm run icons && tsc --noEmit && vite build",
    "dev": "vite",
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev:api": "node --watch --env-file-if-exists=.env server.mjs",
    "dev:all": "node --env-file-if-exists=.env scripts/dev-all.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.545.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "build": {
    "appId": "com.relayroom.desktop",
    "productName": "OpenZero",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "A7me2d",
        "repo": "Codex-Opencode",
        "releaseType": "release",
        "updaterCacheDirName": "opencode-relay-room-updater"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server.mjs",
      "server/**/*",
      "electron/**/*",
      "build/app.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "OpenZero"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/app.ico",
      "uninstallerIcon": "build/app.ico",
      "runAfterFinish": false
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@44.5.1": true
  }
}
